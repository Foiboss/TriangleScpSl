<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ExMod.Exiled" Version="9.14.2" />
      <PackageReference Include="UnityEngine.Modules" Version="2021.3.33">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Assembly-CSharp-firstpass">
        <HintPath>_ProjectDependencies\Assembly-CSharp-firstpass.dll</HintPath>
      </Reference>
      <Reference Include="Mirror">
        <HintPath>_ProjectDependencies\Mirror.dll</HintPath>
      </Reference>
      <Reference Include="Mirror.Components">
        <HintPath>_ProjectDependencies\Mirror.Components.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Core\Decomposition\" />
    </ItemGroup>

</Project>
